# Claude Code benchmark configuration.
# Copy to config/.env and fill in values.

# --------------------------------------------------------------------------
# API authentication.
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=<YOUR_API_KEY>

# Point claude CLI at the local Anthropic-to-OpenAI proxy.
# The proxy translates Anthropic /v1/messages to OpenAI /v1/chat/completions
# and forwards to the upstream endpoint (DashScope or DeepSeek).
# Do NOT include /v1 — the Anthropic SDK appends it automatically.
#
# For compose mode the proxy runs as a sibling service:
ANTHROPIC_BASE_URL=http://anthropic-proxy:8090
#
# For DeepSeek's native Anthropic-compatible endpoint (no proxy needed):
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Upstream endpoint for the proxy (OpenAI-compatible)
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_API_KEY=<YOUR_API_KEY>

# Default model
CLAUDE_MODEL=deepseek-v4-pro

# --------------------------------------------------------------------------
# Benchmark concurrency (parallel tasks)
# --------------------------------------------------------------------------
CLAUDE_CONCURRENCY=4

# --------------------------------------------------------------------------
# Monitoring ports (avoid collisions with openclaw:3001/9090, codex:3000/9090)
# --------------------------------------------------------------------------
CLAUDE_PROMETHEUS_PORT=9092
CLAUDE_GRAFANA_PORT=3002
