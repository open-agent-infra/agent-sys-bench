# LLM endpoint — uses an OpenAI-compatible API.
OPENAI_API_KEY=<YOUR_API_KEY>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name passed to the chat.completions endpoint.
WEBAGENT_MODEL=deepseek-v4-pro

# MiniWoB++ HTML path inside the container (set by Dockerfile).
MINIWOB_URL=file:///opt/miniwob-plusplus/miniwob/html/miniwob/

# Chromium flags (--no-sandbox required in Docker, proxy for network workaround)
WEBAGENT_CHROMIUM_ARGS=--no-sandbox --proxy-server=http://127.0.0.1:8899

# Concurrency
WEBAGENT_CONCURRENCY=1

# WebArena site URLs (BrowserGym requires ALL 7 even if only shopping_admin is deployed)
WA_SHOPPING_ADMIN=http://shopping-admin:80/admin
WA_SHOPPING=http://shopping-admin:80
WA_REDDIT=http://localhost:9999
WA_GITLAB=http://localhost:9998
WA_WIKIPEDIA=http://localhost:9997
WA_MAP=http://localhost:9996
WA_HOMEPAGE=http://localhost:9995
