# LLM Service Configuration -- API Mode
#
# Uses DashScope (OpenAI-compatible) remote API instead of local vLLM.
# No GPU required.

default_model: "deepseek-v4-pro"

instances:
  - name: "dashscope:deepseek-v4-pro:1"
    location: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    model: "deepseek-v4-pro"
    api_key: "YOUR_OPENAI_API_KEY_HERE"

# Global settings
timeout: 30
max_tokens: 4096
temperature: 0.7
