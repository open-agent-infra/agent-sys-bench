# LLM endpoint (OpenAI-compatible, e.g., DashScope)
OPENAI_API_KEY=<YOUR_API_KEY>

# Firecrawl API for web search (get key at https://firecrawl.dev)
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_KEY>

# Compose env vars
AGENT_CONFIG=./config
AGENT_DATA=./data
AGENT_RESULTS=./results
AGENT_CACHE=./cache
AGENT_PATCHES=./patches
NLTK_DATA=/data/nltk_data

# Monitoring
MONITORING_UID=1000
MONITORING_GID=1000
