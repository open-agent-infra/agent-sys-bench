# OpenClaw Docker-Compose Environment
# Copy to config/.env and fill in values.

DEEPSEEK_API_KEY=<YOUR_API_KEY>
FIRECRAWL_API_KEY=
MOONSHOT_API_KEY=

# Toggle sandbox mode (0=off, 1=on)
OPENCLAW_SANDBOX=0

# Number of concurrent tasks
OPENCLAW_CONCURRENCY=4

# Path to WildClawBench tasks directory (mounted into containers)
OPENCLAW_TASKS_DIR=/data/agent-sys-bench

# Multi-node mode:
#   "single"   — all services on one host
#   "multi"    — v1: deploy openclaw-service on remote host
#   "multi-v2" — v2: deploy env-manager on remote host, openclaw-service stays local
OPENCLAW_MODE=single
OPENCLAW_REMOTE_HOST=<REMOTE_HOST>

# Multi-v2 env-manager settings (only needed when OPENCLAW_MODE=multi-v2)
# OPENCLAW_SANDBOX_MODE=ssh
# OPENCLAW_ENV_PORT=1804
