# LLM endpoint for codex (via DashScope OpenAI-compatible mode).
OPENAI_API_KEY=<YOUR_API_KEY>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name passed to codex's `model = ...` setting.
CODEX_MODEL=deepseek-v4-pro

# Per-sandbox resource pool. Pool size is the hard concurrency cap.
CODEX_CPUSETS=0-1,2-3,4-5,6-7
