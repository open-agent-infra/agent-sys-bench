# LLM endpoint (OpenAI-compatible). OSWorld tasks observe via screenshots
# by default, so a multimodal (VLM) model is required.
# Kimi k2.6 has full vision support; DashScope serves it OpenAI-compatibly.
OPENAI_API_KEY=<YOUR_API_KEY>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OS_WORLD_MODEL=kimi-k2.6
# Agent prompt/action format: kimi (Kimi K2.5/K2.6), owl15 (GUI-Owl-1.5), holo3
OS_WORLD_AGENT_KIND=kimi
# Extra JSON fields merged into each kimi chat-completions request. Upstream
# KimiAgent runs in thinking mode; DashScope only returns reasoning_content
# when asked. Drop this for Moonshot's own API.
OS_WORLD_LLM_EXTRA_BODY={"enable_thinking": true}

# Observation type: screenshot (VLM), a11y_tree (text-only), screenshot_a11y_tree
OS_WORLD_OBSERVATION_TYPE=screenshot

# VM provider: docker = QEMU-in-Docker with /dev/kvm passthrough
OS_WORLD_PROVIDER=docker

# Storage for the qcow2 VM image (~24 GB, downloaded on first run).
# Default: <repo>/agents/gui-agent/.cache/vm
#OS_WORLD_DATA_DIR=

# ── VM version pinning (reproducibility) ─────────────────────────────
# The osworld-docker image (QEMU+OVMF runtime) and the Ubuntu qcow2 (from
# xlangai/ubuntu_osworld on HuggingFace) must be version-matched: a newer
# qcow2 (updated shim/UEFI) can fail to boot under an older OVMF.
#
# OS_WORLD_DOCKER_IMAGE: the QEMU runtime image. Default :latest =
#   digest sha256:fe8d9a5e5ad6c593d059887ea2c790481b3f32dd42fa961f2441cdbbe2c70cf4 (2024-10-17).
#   Pin immutably with: happysixd/osworld-docker@sha256:fe8d9a5e5ad6...
#OS_WORLD_DOCKER_IMAGE=happysixd/osworld-docker:latest
#
# OS_WORLD_VM_REVISION: pin the qcow2 to a specific HuggingFace dataset
#   commit (xlangai/ubuntu_osworld). `main` drifts; pin to the commit that
#   matches the osworld-docker image above. Default (baked into the image):
#   1d71c917cb89be34ecb69768c808fe21483dd908 (2024-10-18). `main` = latest.
#OS_WORLD_VM_REVISION=
#
# OS_WORLD_VM_NETWORK: VM networking. `user` (default) = QEMU user-mode
#   (slirp): guest egress is NATed through the host IP, no in-container
#   bridge/DHCP. `tap` = image default (bridge + dnsmasq + vhost-net), faster
#   but on some hosts the guest never gets a DHCP lease ("VM failed to become
#   ready").
#OS_WORLD_VM_NETWORK=user
